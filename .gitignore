# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!deploy/env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local data (embedded Postgres, storage)
.local/

# Nested workspace artifacts
node_modules/
dist/
apps/api/.test-data/
apps/worker/.test-data/
test-results/
playwright-report/
**/tmp/
__pycache__/

# Production backups (on the server)
backups/
.aria-operations.lock
