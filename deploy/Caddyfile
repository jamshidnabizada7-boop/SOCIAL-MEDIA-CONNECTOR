:8080 {
	# Public access uses HTTPS through the named tunnel. Cover web pages and
	# assets as well as the API's own security headers.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Cloudflare sets this to the visitor's scheme, even though the tunnel
	# connects to this private listener over HTTP. Direct health probes omit it.
	@insecure header X-Forwarded-Proto http
	redir @insecure https://{host}{uri} permanent
	# Same-origin product: one public host serves UI and API, so the
	# SameSite=Lax session cookie stays first-party.
	handle /v1/* {
		reverse_proxy api:4100 {
			# Only the named tunnel/loopback reaches this listener. Cloudflare
			# overwrites this header; do not expose this port on a public interface.
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
		}
	}
	handle /health {
		reverse_proxy api:4100
	}
	handle {
		reverse_proxy web:3000
	}
}
