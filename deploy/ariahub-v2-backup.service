[Unit]
Description=Aria Hub v2 consistent database and media backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ariahub-v2
ExecStart=/bin/sh /opt/ariahub-v2/deploy/backup-stack.sh
TimeoutStartSec=20min
TimeoutStopSec=120
UMask=0077
