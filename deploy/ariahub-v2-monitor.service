[Unit]
Description=Aria Hub v2 component and backup monitoring
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ariahub-v2
ExecStart=/usr/bin/python3 /opt/ariahub-v2/scripts/stack_monitor.py
TimeoutStartSec=120
UMask=0077
