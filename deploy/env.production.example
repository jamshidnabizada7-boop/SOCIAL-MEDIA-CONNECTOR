# Aria Hub v2 production environment — copy to /opt/ariahub-v2/.env and fill in.
# Secrets: generate fresh values. Never reuse across environments.

# ─── Database (dedicated v2 instance) ────────────────────────────────────────
POSTGRES_USER=aria
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=ariahub

# 32-byte AES key for OAuth tokens + provider secrets.
# Generate: openssl rand -hex 32
ARIA_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# ─── Public URLs ─────────────────────────────────────────────────────────────
# Public HTTPS base of the API (this is baked into every OAuth redirect URI).
# Quick tunnel now; becomes https://api.myariahub.com once DNS/tunnel is final.
APP_BASE_URL=https://REPLACE-ME.trycloudflare.com

# Allowed web origins, comma-separated (CORS). Include every UI origin.
WEB_ORIGIN=https://REPLACE-ME.vercel.app,https://REPLACE-ME.trycloudflare.com

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
