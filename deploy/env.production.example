# Aria Hub production environment — copy to /opt/ariahub-v2/.env and fill in.
# Generate fresh secrets; never reuse across environments. Keep a copy of
# ARIA_ENCRYPTION_KEY somewhere safe: without it, restored backups can't read
# any connected account.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=aria
# openssl rand -hex 32 (URL-safe for the database connection string)
POSTGRES_PASSWORD=
POSTGRES_DB=ariahub

# ─── Security ────────────────────────────────────────────────────────────────
# openssl rand -hex 32   (64 hex characters; anything else is rejected at boot)
ARIA_ENCRYPTION_KEY=

# ─── Public URLs ─────────────────────────────────────────────────────────────
# One public host serves both UI and API (Caddy routes /v1/* to the API).
# Register {APP_BASE_URL}/v1/oauth/callback/{provider} with every provider.
APP_BASE_URL=https://app.example.com
WEB_ORIGIN=https://app.example.com

# ─── Cloudflare named tunnel (permanent hostname) ────────────────────────────
# Zero Trust → Networks → Tunnels → Create → Docker → copy the token.
# Public hostname app.example.com → Service http://caddy:8080
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Email (password reset, verification, invitations, failure alerts) ───────
# Any SMTP provider (Resend, Postmark, SES, Brevo…). Verify the sending domain (SPF/DKIM).
SMTP_URL=
MAIL_FROM="Aria Hub <no-reply@example.com>"

# ─── Billing (optional — leave empty to run Free-only) ───────────────────────
# Stripe webhook endpoint: {APP_BASE_URL}/v1/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ─── Legal pages (baked into the web build) ──────────────────────────────────
LEGAL_ENTITY="Your Company Ltd., street, city, country"
CONTACT_EMAIL=privacy@example.com
LEGAL_UPDATED=2026-10-24

# ─── Provider apps (or enter them in Admin → Provider credentials) ───────────
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_POSTING_ENABLED=false
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# META_GRAPH_VERSION=v23.0
# WEBHOOK_SECRET_FACEBOOK=      (the Meta app secret)
# WEBHOOK_VERIFY_TOKEN=         (openssl rand -hex 16; enter the same value in Meta's webhook setup)

# ─── Operations ──────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
BACKUP_KEEP_DAYS=14
# Error tracking (optional): Sentry DSN for api, worker and web server.
# SENTRY_DSN=
# Browser project DSN, public by design; baked into the web build.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_RELEASE=git-commit-sha
# Off-site backups: configure rclone, then schedule backup-offsite.sh.
# ARIA_BACKUP_REMOTE=offsite:ariahub-backups
LOG_LEVEL=info
