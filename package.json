{
  "name": "ariahub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "npm run dev -w @aria/web",
    "build:web": "npm run build -w @aria/web",
    "start:web": "npm run start -w @aria/web",
    "dev:api": "npm run dev -w @aria/api",
    "build:api": "npm run build -w @aria/api",
    "start:api": "npm run start -w @aria/api",
    "dev:worker": "npm run dev -w @aria/worker",
    "build:worker": "npm run build -w @aria/worker",
    "start:worker": "npm run start -w @aria/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate -w @aria/db",
    "db:migrate": "npm run migrate -w @aria/db",
    "db:seed": "npm run seed -w @aria/db",
    "dev:db": "tsx packages/db/src/server.ts",
    "lint": "eslint apps/api apps/worker packages && npm run lint -w @aria/web",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/worker && tsc --noEmit -p packages/db && tsc --noEmit -p packages/shared-types && tsc --noEmit -p packages/providers-core && tsc --noEmit -p packages/media-core"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "14.0.0",
    "typescript-eslint": "8.71.0"
  }
}
