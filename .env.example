# Aria Hub configuration. Local development needs none of these: the stack
# runs on embedded Postgres (PGlite under .local/) with an auto-generated dev
# encryption key. Production values live in deploy/env.production.example.

# ─── URLs ────────────────────────────────────────────────────────────────────
# Public base URL of the API. OAuth redirect URIs are {APP_BASE_URL}/v1/oauth/callback/{provider};
# Instagram/Threads fetch media from {APP_BASE_URL}/v1/media/:id/public (must be https in production).
APP_BASE_URL=http://localhost:4100
# Web app origin(s) allowed to call the API with cookies (comma-separated). The first one is
# where OAuth and email links send people.
WEB_ORIGIN=http://localhost:3000
# Override for links in emails when they differ from the first WEB_ORIGIN.
# APP_WEB_URL=https://app.example.com
# Public site URL shown in provider app registrations.
# APP_WEBSITE=https://example.com
# Optional separate public origin for provider media fetches (defaults to APP_BASE_URL).
# APP_PUBLIC_MEDIA_BASE_URL=

# ─── API (apps/api) ──────────────────────────────────────────────────────────
PORT=4100
HOST=127.0.0.1
# Proxy hops to trust for client IPs: a count ("2" for Cloudflare → Caddy) or an IP/CIDR list.
# Unset trusts nothing (direct connections).
# TRUST_PROXY=2
# Cookie Domain when web and API are sibling subdomains, e.g. ".example.com".
# SESSION_COOKIE_DOMAIN=
# LOG_LEVEL=info
# SENTRY_DSN=                         # API, worker and web server errors
# SENTRY_RELEASE=git-commit-sha

# ─── Database & storage ──────────────────────────────────────────────────────
# Postgres. Unset = embedded local database. For local dev with both api and
# worker, run `npm run dev:db` and use postgres://aria:aria@127.0.0.1:5438/ariahub
# DATABASE_URL=
# Embedded DB directory (when DATABASE_URL is unset). Default: .local/ariahub-pg
# ARIA_DATA_DIR=
# Port for `npm run dev:db` (PGlite over the Postgres wire protocol).
# ARIA_PG_PORT=5438
# Uploaded media. Default: .local/storage. Must be shared by api and worker.
# ARIA_STORAGE_DIR=

# ─── Security ────────────────────────────────────────────────────────────────
# 32-byte key (64 hex chars or base64) for AES-256-GCM encryption of OAuth tokens and for
# signing public media links. REQUIRED in production. Generate: openssl rand -hex 32
# Changing it makes every stored connection unreadable — back it up with the database.
# ARIA_ENCRYPTION_KEY=

# ─── Email (password reset, verification, invitations, failure alerts) ───────
# Without SMTP_URL, development logs emails instead of sending; production sends nothing.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM="Aria Hub <no-reply@example.com>"

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY, paid plans are unavailable (platform admins can still assign plans).
# Webhook endpoint to register in Stripe: {APP_BASE_URL}/v1/billing/webhook
#   events: checkout.session.completed, customer.subscription.created|updated|deleted, invoice.payment_failed
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...

# ─── Worker (apps/worker) ────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
# Local-only liveness endpoint for the container healthcheck.
# WORKER_HEALTH_PORT=4101
# Route every provider through the mock adapter (tests, offline demos). Never in production.
# ARIA_ADAPTER_MODE=mock

# ─── Provider apps ───────────────────────────────────────────────────────────
# Register this redirect URI with every provider: {APP_BASE_URL}/v1/oauth/callback/{provider}
# Credentials can also be entered in Admin → Provider credentials (the database wins).
# FACEBOOK_APP_ID= / FACEBOOK_APP_SECRET=      (Facebook Pages + Instagram)
# THREADS_APP_ID= / THREADS_APP_SECRET=
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET=
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=    (YouTube)
# X_CLIENT_ID= / X_CLIENT_SECRET=
# PINTEREST_APP_ID= / PINTEREST_APP_SECRET=
# TIKTOK_CLIENT_KEY= / TIKTOK_CLIENT_SECRET=   (connect is disabled until a TikTok adapter ships)
# Meta Graph API version; bump after checking Meta's changelog.
# META_GRAPH_VERSION=v23.0
# LinkedIn Marketing API version header (YYYYMM).
# LINKEDIN_API_VERSION=202609
# X posting is metered (paid API tier). Set to true once budgeted.
# X_POSTING_ENABLED=false
# Bluesky needs no app; optional custom PDS:
# BLUESKY_INSTANCE=https://bsky.social
# Mastodon apps are registered per instance at connect time.
# Allow http:// and private-network instances (local Mastodon dev only; ignored in production).
# ARIA_ALLOW_PRIVATE_INSTANCES=false

# ─── Webhooks ────────────────────────────────────────────────────────────────
# HMAC secret per provider (Meta: the app secret). Endpoint: {APP_BASE_URL}/v1/webhooks/{provider}
# WEBHOOK_SECRET_FACEBOOK=
# Token for Meta's subscription handshake (hub.verify_token); per provider or shared.
# WEBHOOK_VERIFY_TOKEN=

# ─── Web (apps/web/.env.local — baked in at build time) ──────────────────────
# NEXT_PUBLIC_DATA_MODE=api              # "mock" = self-contained demo
# NEXT_PUBLIC_API_URL=http://localhost:4100
# NEXT_PUBLIC_LEGAL_ENTITY="Your Company Ltd., address"
# NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com
# NEXT_PUBLIC_LEGAL_UPDATED=2026-10-24
# NEXT_PUBLIC_SENTRY_DSN=             # browser errors (public DSN)
